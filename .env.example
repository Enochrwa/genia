# Copy to .env. Never commit real secrets. Values below are for local development only.
NODE_ENV=development

# Database and cache (docker compose up -d)
DATABASE_URL=postgresql://genia:genia@localhost:5432/genia
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=
TRUST_PROXY=false
DEFAULT_COUNTRY=RW

# Secrets (production: use a secret manager; all three must differ and must not start with dev-only/change-me)
JWT_ACCESS_SECRET=dev-only-jwt-secret-change-before-production-0123456789
PIN_PEPPER=dev-only-pin-pepper-0123456789
OTP_PEPPER=dev-only-otp-pepper-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# OTP and PIN rules
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUESTS_PER_PHONE=3
OTP_REQUESTS_PER_PHONE_WINDOW_SECONDS=600
OTP_REQUESTS_PER_IP=20
OTP_VERIFY_PER_PHONE=10
OTP_VERIFY_PER_IP=60
PIN_MAX_FAILURES=5
PIN_LOCK_MINUTES=30

# SMS: "console" prints codes to the API log (development only), "africastalking" sends real SMS
SMS_PROVIDER=console
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_SENDER_ID=
AFRICAS_TALKING_BASE_URL=

# Payments (later sprints)
PAYMENTS_ENABLED=false
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# Feature flags (default off for real money)
FEATURE_REAL_MONEY=false
FEATURE_MULTIPLAYER=false

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
