# Copy to .env. Never commit real secrets.
NODE_ENV=development

# Database and cache
DATABASE_URL=postgresql://genia:genia@localhost:5432/genia
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
PIN_PEPPER=change-me
ENCRYPTION_KEY=change-me-32-bytes

# OTP / SMS
SMS_PROVIDER=console
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox

# Payments (sandbox)
PAYMENTS_ENABLED=false
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# Feature flags (default off for real money)
FEATURE_REAL_MONEY=false
FEATURE_MULTIPLAYER=false

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
